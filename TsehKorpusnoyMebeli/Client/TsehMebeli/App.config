<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <connectionStrings>
    <add name="TsehMebeli"
         connectionString="Data Source=HOME-PC;Initial Catalog=TsehMebeliDB;Integrated Security=True;Encrypt=True;TrustServerCertificate=True;Pooling=True;MultipleActiveResultSets=False;Application Name=TsehMebeli Client;Connect Timeout=15;"
         providerName="Microsoft.Data.SqlClient" />
  </connectionStrings>
  <appSettings>
    <add key="ApiBaseUrl" value="https://localhost:7150/" />
    <add key="LogPath" value="logs\tsehmebeli.log" />
  </appSettings>
</configuration>
