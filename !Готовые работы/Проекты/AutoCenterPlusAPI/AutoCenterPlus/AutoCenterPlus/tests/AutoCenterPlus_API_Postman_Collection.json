                                                        "key":  "Cookie",
                                                        "value":  "{{sessionCookie}}",
                                                        "type":  "text"
                                                    }
                                                ],
                                     "url":  "{{baseUrl}}/api/analysis"
                                 },
                     "event":  [
                                   {
                                       "listen":  "test",
                                       "script":  {
                                                      "type":  "text/javascript",
                                                      "exec":  [
                                                                   "const body = rf.response.getBodyJSON();",
                                                                   "test(\u0027returns 200\u0027, () =\u003e rf.response.getStatusCode() === 200);",
                                                                   "test(\u0027body is an array\u0027, () =\u003e Array.isArray(body));",
                                                                   "test(\u0027analysis has a discount percentage\u0027, () =\u003e Array.isArray(body) \u0026\u0026 (!body.length || Object.prototype.hasOwnProperty.call(body[0], \u0027discountPercent\u0027)));"
                                                               ]
                                                  }
                                   }
                               ]
                 },
                 {
                     "name":  "Analysis filtered by customer",
                     "request":  {
                                     "method":  "GET",
                                     "header":  [
                                                    {
                                                        "key":  "Cookie",
                                                        "value":  "{{sessionCookie}}",
                                                        "type":  "text"
                                                    }
                                                ],
                                     "url":  "{{baseUrl}}/api/analysis?customerId={{customerId}}"
                                 },
                     "event":  [
                                   {
                                       "listen":  "test",
                                       "script":  {
                                                      "type":  "text/javascript",
                                                      "exec":  [
                                                                   "const body = rf.response.getBodyJSON();",
                                                                   "const customerId = Number(new URL(rf.request.getURL()).searchParams.get(\u0027customerId\u0027));",
                                                                   "test(\u0027returns 200\u0027, () =\u003e rf.response.getStatusCode() === 200);",
                                                                   "test(\u0027all returned rows belong to selected client\u0027, () =\u003e Array.isArray(body) \u0026\u0026 body.every(row =\u003e row.clientId === customerId));"
                                                               ]
                                                  }
                                   }
                               ]
                 }
             ]
}
